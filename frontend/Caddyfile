# Serves the built frontend and proxies the API to the backend. Set SITE_ADDRESS to a
# public domain and Caddy provisions HTTPS automatically; it defaults to :80 locally.
{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		# The frontend HTML/JS/CSS is served here (not by the backend), so the security
		# headers, including the Content-Security-Policy that governs script and style
		# execution, must be set here. They mirror the backend's policy. To fall back to
		# monitoring only, rename the header to Content-Security-Policy-Report-Only.
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			-Server
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
