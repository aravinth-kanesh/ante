# Serves the built frontend and proxies the API to the backend. Set SITE_ADDRESS to a
# public domain and Caddy provisions HTTPS automatically; it defaults to :80 locally.
{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
