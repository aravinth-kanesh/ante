# Deployment settings for docker-compose.yml. Copy to `.env` (kept out of git) and fill
# in, then run:  docker compose up -d --build

# A long random string. Required. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# The PostgreSQL password for the bundled database.
DB_PASSWORD=change-me

# Your public domain. Caddy provisions HTTPS automatically for a real domain; leave as
# ":80" to serve plain http locally.
SITE_ADDRESS=your-domain.com
# The browser origin the backend should trust (used for CORS). Use https and your domain.
SITE_ORIGIN=https://your-domain.com

# Language model (OpenAI-compatible). Set these, or set LLM_FAKE=1 to run without a key.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=your-api-key
LLM_MODEL=mistral-small-latest
LLM_FAKE=0

# Optional: ground company research in DuckDuckGo results (no API key needed).
WEB_SEARCH_ENABLED=0

# IMPORTANT: in production, new users must verify their email before they can log in.
# So EITHER configure SMTP below so verification emails are sent, OR set
# REQUIRE_EMAIL_VERIFICATION=0 to let users in immediately (fine for a controlled study).
REQUIRE_EMAIL_VERIFICATION=0

# Email (only needed if REQUIRE_EMAIL_VERIFICATION is not 0). Without SMTP_HOST the
# verification/reset links are written to the backend logs instead of emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Ante <no-reply@your-domain.com>
# APP_BASE_URL=https://your-domain.com

# Leave COOKIE_SECURE unset in production (cookies are Secure behind TLS). Set to 0 only
# to test the stack locally over plain http.
# COOKIE_SECURE=0
