# Ante backend configuration. Copy to `.env` and fill in. Every key maps to a field in
# app/config.py (the variable name is the field name in upper case). Only a few are
# needed to run; the rest have sensible defaults.

# --- Environment and security -------------------------------------------------------
# "production" enforces a real JWT secret, marks cookies Secure, and requires verified
# email. Leave as "development" for local use.
ENVIRONMENT=production
# A long random string. The app refuses to start in production with the default.
JWT_SECRET=change-me-to-a-long-random-string
# The browser origin the frontend is served from (comma-separated for several).
BACKEND_CORS_ORIGINS=https://your-domain

# --- Database -----------------------------------------------------------------------
# SQLite by default (dev). Use PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ante
DATABASE_URL=sqlite:///./app.db

# --- Language model (OpenAI-compatible) ---------------------------------------------
# Point at any OpenAI-compatible chat API. Set LLM_FAKE=1 to run with a deterministic
# offline stand-in and no key at all (useful for a demo).
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=your-api-key
LLM_MODEL=mistral-small-latest
LLM_FAKE=0

# --- Web-grounded company research (optional, no API key) ---------------------------
# When on, a few DuckDuckGo snippets about the company ground the research prompt.
WEB_SEARCH_ENABLED=0

# --- Email (verification and password reset) ----------------------------------------
# Without SMTP_HOST, links are written to the logs instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Ante <no-reply@your-domain>
# APP_BASE_URL=https://your-domain

# --- Hardening (optional) -----------------------------------------------------------
# The Content-Security-Policy is enforced by default. Set this to true to fall back to
# report-only (monitoring) if you ever need to.
# CSP_REPORT_ONLY=true
# Shared rate-limit / refresh storage for multiple workers.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# Temporary answer-recording store (deleted when a session ends).
# SESSION_MEDIA_DIR=var/session_media
