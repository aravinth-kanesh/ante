# Copy this file to .env and fill in your key. .env is gitignored.

# LLM endpoint. Defaults target KCL's OpenAI-compatible API.
LLM_BASE_URL=https://api.ai.create.kcl.ac.uk/v1
LLM_API_KEY=sk-your-kcl-key-here
LLM_MODEL=arc:lite

# Origins allowed to call the API from the browser (comma-separated).
BACKEND_CORS_ORIGINS=http://localhost:5173

# To use OpenAI instead (spends credit), set:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...your-openai-key...
#   LLM_MODEL=gpt-4o-mini
