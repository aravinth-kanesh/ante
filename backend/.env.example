# Copy this file to .env and fill in your key. .env is gitignored.

# LLM endpoint. Any OpenAI-compatible chat API works; put your key here.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Origins allowed to call the API from the browser (comma-separated).
BACKEND_CORS_ORIGINS=http://localhost:5173

# Environment: "development" or "production". In production the app refuses to
# start unless JWT_SECRET is set to a strong value, and adds HSTS headers.
ENVIRONMENT=development

# Database. SQLite is fine for development; use PostgreSQL for real deployments:
#   DATABASE_URL=postgresql://user:password@host:5432/ante
DATABASE_URL=sqlite:///./app.db

# Auth. Generate a strong secret, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Session cookies. COOKIE_SECURE is empty to mean "on in production"; set SameSite
# to "none" only for a cross-site frontend (then it must also be Secure). CSRF is a
# double-submit token echoed in the X-CSRF-Token header on state-changing requests.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
CSRF_ENABLED=true

# Rate limits (per client IP). RATE_LIMIT_STORAGE_URI is in-memory when empty; point
# it at Redis (e.g. redis://localhost:6379) for a multi-worker deployment.
AUTH_RATE_LIMIT=10/minute
LLM_RATE_LIMIT=30/minute
SPEECH_RATE_LIMIT=60/minute
VISION_RATE_LIMIT=120/minute
UPLOAD_RATE_LIMIT=20/minute
RATE_LIMIT_STORAGE_URI=

# Account security. Verification is on by default in production; empty means "follow
# the environment". Breached passwords are rejected via the Have I Been Pwned API.
REQUIRE_EMAIL_VERIFICATION=
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CHECK_BREACHED_PASSWORDS=true

# Outgoing email. With SMTP_HOST empty, verification and reset links are written to
# the log instead of sent, which is convenient for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ante <no-reply@ante.local>
SMTP_TLS=true
APP_BASE_URL=http://localhost:5173

# Transport hardening. The CSP starts in report-only; set CSP_REPORT_ONLY=false to
# enforce it once it has been checked in the browser.
CSP_REPORT_ONLY=true
MAX_REQUEST_BYTES=10485760

# Logging. "text" for readable local logs, "json" for structured production logs.
LOG_LEVEL=INFO
LOG_FORMAT=text

# Moderation. Each check is a separate model call (up to three per message).
# Set MODERATE_INPUT_ENABLED=false to halve the calls if the provider rate-limits.
MODERATION_ENABLED=true
MODERATE_INPUT_ENABLED=true
MODERATE_OUTPUT_ENABLED=true
MODERATION_MODEL=
MODERATION_MAX_RETRIES=1
